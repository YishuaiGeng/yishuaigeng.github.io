---
import PostList from '@components/blog/PostList.astro';
import EmptyState from '@components/EmptyState.astro';
import Pagination from '@components/Pagination.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { fetchExternalPosts } from '@utils/external-posts';
import { paginateItems } from '@utils/posts';
import { readingTime } from '@utils/reading-time';
import { getCollection } from 'astro:content';

import IconArrowRight from '~icons/fa-solid/arrow-right';
import IconBookOpen from '~icons/fa-solid/book-open';
import IconClock from '~icons/fa-solid/clock';
import IconCode from '~icons/fa-solid/code';
import IconGraduationCap from '~icons/fa-solid/graduation-cap';
import IconHashtag from '~icons/fa-solid/hashtag';
import IconPen from '~icons/fa-solid/pen';
import IconRss from '~icons/fa-solid/rss';
import IconTags from '~icons/fa-solid/tags';
import IconThumbtack from '~icons/fa-solid/thumbtack';

const localPosts = (await getCollection('blogs'))
  .filter((p) => !p.data.hidden && !p.data.draft)
  .sort((a, b) => {
    if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });

const externalPosts = await fetchExternalPosts();

type LocalPost = (typeof localPosts)[number];
type ExternalPost = {
  external: true;
  id: string;
  url: string;
  data: {
    title: string;
    date: Date;
    description?: string;
    tags: string[];
    categories: string[];
    image?: string;
  };
  body?: undefined;
};

const allPosts: (LocalPost | ExternalPost)[] = [
  ...localPosts,
  ...externalPosts.map((ep) => ({
    external: true as const,
    id: ep.url,
    url: ep.url,
    body: undefined,
    data: {
      title: ep.title,
      date: ep.publishedDate,
      description: ep.description,
      tags: ep.tags,
      categories: ep.categories,
      image: undefined,
    },
  })),
].sort((a, b) => {
  const aPin = 'pinned' in a.data ? (a.data as { pinned?: boolean }).pinned : false;
  const bPin = 'pinned' in b.data ? (b.data as { pinned?: boolean }).pinned : false;
  if (aPin !== bPin) return aPin ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
});

const perPage = site.blog.postsPerPage;
const totalPages = Math.ceil(allPosts.length / perPage);
const pagePosts = paginateItems(allPosts, 1, perPage);

// Featured cards count toward the first page limit and are omitted from its list below.
const pinnedPosts = localPosts.filter((post) => post.data.pinned).slice(0, perPage);
const pinnedIds = new Set(pinnedPosts.map((post) => post.id));
const listedPagePosts = pagePosts.filter((post) => !pinnedIds.has(post.id));

const displayTags = site.blog.displayTags;
const collections = site.blog.collections;

const collectionIcons = {
  book: IconBookOpen,
  learning: IconGraduationCap,
  code: IconCode,
  pen: IconPen,
};

const { labels } = site.blog;
const dateFormat = new Intl.DateTimeFormat(site.lang, { dateStyle: 'medium', timeZone: 'UTC' });
---

<Page title={site.blog.name} description={site.blog.description}>
  <header class="blog-header">
    <p class="blog-eyebrow">{labels.notebook}</p>
    <div class="blog-title-row">
      <h1>{site.blog.name}<span class="title-dot" aria-hidden="true">.</span></h1>
      <a class="rss-link" href={`${site.base}/rss.xml`}
        ><IconRss aria-hidden="true" />{labels.rss}</a
      >
    </div>
    <p class="blog-description">{site.blog.description}</p>
    <div class="blog-stats">
      <span
        ><strong>{allPosts.length}</strong>
        {allPosts.length === 1 ? labels.noteSingular : labels.notePlural}</span
      >
      <span class="stats-divider" aria-hidden="true"></span>
      <span
        ><strong>{collections.length}</strong>
        {labels.collections.toLocaleLowerCase(site.lang)}</span
      >
    </div>
  </header>

  <div class="blog-layout">
    <aside class="blog-directory">
      <section aria-labelledby="collections-heading">
        <h2 id="collections-heading">{labels.collections}</h2>
        <nav class="collection-list" aria-labelledby="collections-heading">
          {
            collections.map((collection) => {
              const CollectionIcon = collectionIcons[collection.icon];
              const count = allPosts.filter((post) =>
                post.data.categories.includes(collection.name),
              ).length;
              return (
                <a
                  class="collection-link"
                  href={`${site.base}/blog/category/${encodeURIComponent(collection.name)}/`}
                  title={collection.description}
                >
                  <CollectionIcon aria-hidden="true" />
                  <span class="collection-name">{collection.name}</span>
                  <span
                    class="collection-count"
                    aria-label={`${count} ${count === 1 ? labels.noteSingular : labels.notePlural}`}
                  >
                    {count}
                  </span>
                </a>
              );
            })
          }
        </nav>
      </section>
      <section class="topic-directory" aria-labelledby="topics-heading">
        <h2 id="topics-heading">{labels.topics}</h2>
        <div class="topic-links">
          {
            displayTags.map((tag) => (
              <a href={`${site.base}/blog/tag/${encodeURIComponent(tag)}/`}>
                <>
                  <IconHashtag aria-hidden="true" />
                  <span>{tag}</span>
                </>
              </a>
            ))
          }
        </div>
        <a class="all-tags-link" href={`${site.base}/blog/tags/`}
          ><IconTags aria-hidden="true" />{labels.allTags}<IconArrowRight aria-hidden="true" /></a
        >
      </section>
    </aside>

    <div class="blog-main">
      {
        pinnedPosts.length > 0 && (
          <section class="featured-posts" aria-labelledby="pinned-heading">
            <h2 id="pinned-heading">
              <IconThumbtack aria-hidden="true" />
              {labels.pinned}
            </h2>
            <div class="pinned-list">
              {pinnedPosts.map((post) => (
                <a class="pinned-note" href={post.data.redirect || `${site.base}/blog/${post.id}/`}>
                  <div class="pinned-copy">
                    <h3>{post.data.title}</h3>
                    {post.data.description && <p>{post.data.description}</p>}
                    <span class="pinned-meta">
                      <time datetime={post.data.date.toISOString()}>
                        {dateFormat.format(post.data.date)}
                      </time>
                      {post.body && (
                        <span class="pinned-reading-time">
                          <IconClock aria-hidden="true" />
                          {readingTime(post.body, site.blog.wordsPerMinute)} {labels.readingTime}
                        </span>
                      )}
                    </span>
                  </div>
                  <IconArrowRight class="pinned-arrow" aria-hidden="true" />
                </a>
              ))}
            </div>
          </section>
        )
      }

      <section
        aria-labelledby="notes-heading"
        hidden={pagePosts.length > 0 && listedPagePosts.length === 0}
      >
        <div class="notes-heading">
          <h2 id="notes-heading">
            {site.blog.timeline.enabled ? labels.timeline : labels.allNotes}
          </h2>
          <span>{labels.newestFirst}</span>
        </div>
        {
          pagePosts.length === 0 ? (
            <EmptyState title={site.blog.emptyTitle} description={site.blog.emptyMessage} />
          ) : (
            <PostList posts={listedPagePosts} />
          )
        }
      </section>

      <Pagination
        currentPage={1}
        totalPages={totalPages}
        prevUrl={undefined}
        nextUrl={totalPages > 1 ? `${site.base}/blog/page/2/` : undefined}
        basePath={`${site.base}/blog/`}
      />
    </div>
  </div>
</Page>

<style>
  .blog-header {
    border-bottom: 1px solid var(--global-divider-color);
    padding: 0.75rem 0 1.75rem;
    margin-bottom: 2rem;
  }

  .blog-eyebrow {
    color: var(--global-theme-color);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    margin: 0 0 0.35rem;
    text-transform: uppercase;
  }

  .blog-title-row {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .blog-title-row h1 {
    font-size: clamp(2.25rem, 5vw, 2.85rem);
    letter-spacing: -0.05em;
    line-height: 1.2;
    margin: 0;
  }

  .title-dot {
    color: var(--global-theme-color);
  }

  .rss-link {
    align-items: center;
    border: 1px solid var(--global-divider-color);
    border-radius: 2rem;
    color: var(--global-text-color-light);
    display: inline-flex;
    flex-shrink: 0;
    font-size: 0.75rem;
    gap: 0.5rem;
    padding: 0.5rem 0.8rem;
  }

  .rss-link:hover {
    border-color: var(--global-theme-color);
    color: var(--global-theme-color);
  }

  .rss-link :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
  }

  .blog-description {
    color: var(--global-text-color-light);
    font-size: 0.95rem;
    line-height: 1.8;
    margin: 0.8rem 0 0;
    max-width: 39rem;
  }

  .blog-stats {
    align-items: center;
    color: var(--global-text-color-light);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.75rem;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .blog-stats strong {
    color: var(--global-text-color);
    font-weight: 500;
  }

  .stats-divider {
    background: var(--global-divider-color);
    height: 0.85rem;
    width: 1px;
  }

  .blog-layout {
    align-items: start;
    column-gap: 2.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
  }

  .blog-main {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .blog-directory {
    border-left: 1px solid var(--global-divider-color);
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    padding-left: 1.5rem;
    position: sticky;
    top: calc(var(--navbar-height) + 2rem);
  }

  .blog-directory h2 {
    color: var(--global-text-color-light);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin: 0 0 0.8rem;
    text-transform: uppercase;
  }

  .collection-list {
    display: grid;
    gap: 0.3rem;
  }

  .collection-link {
    align-items: center;
    border-radius: 6px;
    color: var(--global-text-color);
    display: flex;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.4rem;
    transition: background-color 160ms ease;
  }

  .collection-link:hover {
    background: var(--global-card-bg-color);
    color: var(--global-theme-color);
  }

  .collection-link :global(svg) {
    color: var(--global-text-color-light);
    flex: 0 0 auto;
    height: 0.85rem;
    width: 0.85rem;
  }

  .collection-name {
    flex: 1;
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  .collection-count {
    color: var(--global-text-color-light);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .topic-directory {
    border-top: 1px solid var(--global-divider-color);
    margin-top: 1.3rem;
    padding-top: 1.4rem;
  }

  .topic-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .topic-links a {
    align-items: baseline;
    border: 1px solid var(--global-divider-color);
    border-radius: 5px;
    color: var(--global-text-color-light);
    display: inline-flex;
    font-size: 0.68rem;
    gap: 0.25rem;
    max-width: 100%;
    padding: 0.3rem 0.45rem;
  }

  .topic-links a span {
    overflow-wrap: anywhere;
  }

  .topic-links a:hover {
    border-color: var(--global-theme-color);
    color: var(--global-theme-color);
  }

  .topic-links :global(svg) {
    flex: 0 0 auto;
    height: 0.55rem;
    width: 0.55rem;
  }

  .all-tags-link {
    align-items: center;
    display: inline-flex;
    font-size: 0.75rem;
    gap: 0.5rem;
    margin-top: 0.8rem;
    min-height: 2rem;
  }

  .all-tags-link :global(svg) {
    height: 0.7rem;
    width: 0.7rem;
  }

  .featured-posts {
    margin-bottom: 2rem;
  }

  .featured-posts > h2 {
    align-items: center;
    color: var(--global-text-color-light);
    display: flex;
    font-size: 0.7rem;
    font-weight: 500;
    gap: 0.4rem;
    margin: 0 0 0.7rem;
  }

  .featured-posts > h2 :global(svg) {
    height: 0.65rem;
    width: 0.65rem;
  }

  .pinned-list {
    display: grid;
    gap: 0.75rem;
  }

  .pinned-note {
    align-items: center;
    background: color-mix(in srgb, var(--global-theme-color) 4%, var(--global-bg-color));
    border: 1px solid color-mix(in srgb, var(--global-theme-color) 20%, var(--global-divider-color));
    border-radius: 8px;
    color: var(--global-text-color);
    display: flex;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    transition: border-color 160ms ease;
  }

  .pinned-note:hover {
    border-color: var(--global-theme-color);
  }

  .pinned-copy {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .pinned-copy h3 {
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .pinned-copy p {
    color: var(--global-text-color-light);
    font-size: 0.8rem;
    line-height: 1.75;
    margin: 0.4rem 0 0;
  }

  .pinned-meta,
  .pinned-reading-time {
    align-items: center;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pinned-meta {
    color: var(--global-text-color-light);
    font-size: 0.7rem;
    margin-top: 0.6rem;
  }

  .pinned-reading-time {
    gap: 0.3rem;
  }

  .pinned-reading-time :global(svg) {
    height: 0.7rem;
    width: 0.7rem;
  }

  .pinned-note :global(.pinned-arrow) {
    color: var(--global-theme-color);
    flex: 0 0 auto;
    height: 0.85rem;
    width: 0.85rem;
  }

  .notes-heading {
    align-items: baseline;
    border-bottom: 1px solid var(--global-divider-color);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
    padding-bottom: 0.65rem;
  }

  .notes-heading h2 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
  }

  .notes-heading > span {
    color: var(--global-text-color-light);
    font-size: 0.7rem;
  }

  a:focus-visible {
    outline: 2px solid var(--global-theme-color);
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .blog-header {
      margin-bottom: 1.5rem;
    }

    .blog-layout {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    .blog-directory {
      border: 0;
      padding: 0;
      position: static;
      width: 100%;
    }

    .collection-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .collection-link {
      border: 1px solid var(--global-divider-color);
      gap: 0.5rem;
      min-height: 2.5rem;
      padding: 0.45rem 0.65rem;
    }

    .collection-name {
      font-size: 0.75rem;
    }

    .topic-directory {
      border: 0;
      margin-top: 1rem;
      padding: 0;
    }

    .topic-directory h2,
    .topic-links {
      display: none;
    }

    .all-tags-link {
      margin: 0;
    }

    .blog-main {
      width: 100%;
    }

    .pinned-note {
      padding: 0.9rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-link,
    .pinned-note {
      transition: none;
    }
  }
</style>
