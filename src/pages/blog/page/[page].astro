---
import PostList from '@components/blog/PostList.astro';
import Pagination from '@components/Pagination.astro';
import { site } from '@config/site';
import PageLayout from '@layouts/Page.astro';
import { fetchExternalPosts } from '@utils/external-posts';
import { paginateItems } from '@utils/posts';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const localPosts = (await getCollection('blogs'))
    .filter((p) => !p.data.hidden && !p.data.draft)
    .sort((a, b) => {
      if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
      return b.data.date.getTime() - a.data.date.getTime();
    });
  const externalPosts = await fetchExternalPosts();
  const allPosts = [
    ...localPosts,
    ...externalPosts.map((post) => ({
      external: true as const,
      id: post.url,
      url: post.url,
      body: undefined,
      data: {
        title: post.title,
        date: post.publishedDate,
        description: post.description,
        tags: post.tags,
        categories: post.categories,
        image: undefined,
      },
    })),
  ].sort((a, b) => {
    const aPinned = 'pinned' in a.data ? a.data.pinned : false;
    const bPinned = 'pinned' in b.data ? b.data.pinned : false;
    if (aPinned !== bPinned) return aPinned ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });

  const perPage = site.blog.postsPerPage;
  const totalPages = Math.ceil(allPosts.length / perPage);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2; // pages 2, 3, ...
    return {
      params: { page: String(page) },
      props: {
        posts: paginateItems(allPosts, page, perPage),
        currentPage: page,
        totalPages,
      },
    };
  });
}

const { posts, currentPage, totalPages } = Astro.props;
const base = site.base;
---

<PageLayout title={`${site.blog.name} — Page ${currentPage}`} description={site.blog.description}>
  <header class="post-header">
    <h1 class="post-title heading-with-icon">
      <span class="heading-emoji" aria-hidden="true">📝</span>
      <span>{site.blog.name}</span>
    </h1>
    <p class="post-description">{site.blog.description}</p>
  </header>

  <PostList posts={posts} />

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    prevUrl={currentPage === 2 ? `${base}/blog/` : `${base}/blog/page/${currentPage - 1}/`}
    nextUrl={currentPage < totalPages ? `${base}/blog/page/${currentPage + 1}/` : undefined}
    basePath={`${base}/blog/`}
  />
</PageLayout>
