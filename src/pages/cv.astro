---
import CVEntry from '@components/cv/CVEntry.astro';
import CVInstitutionGroup from '@components/cv/CVInstitutionGroup.astro';
import CVPublicationEntry from '@components/cv/CVPublicationEntry.astro';
import CVSection from '@components/cv/CVSection.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import type { JSONResume, RenderCV, RenderCVEntry } from '@utils/cv';
import { formatCVDate, formatDateRange, sortCVEntriesByDate } from '@utils/cv';
import yaml from 'js-yaml';

import IconFilePdf from '~icons/fa-solid/file-pdf';

import cvRaw from '../data/cv.yml?raw';
import resumeData from '../data/resume.json';

const format = site.cv.format;

const renderCV = format === 'rendercv' ? (yaml.load(cvRaw) as RenderCV) : null;
const jsonResume = format === 'jsonresume' ? (resumeData as JSONResume) : null;

const rc = renderCV?.cv ?? null;
const education = sortCVEntriesByDate((rc?.sections?.education ?? []) as RenderCVEntry[]);
const experience = sortCVEntriesByDate((rc?.sections?.experience ?? []) as RenderCVEntry[]);
const rcPublications = sortCVEntriesByDate((rc?.sections?.publications ?? []) as RenderCVEntry[]);
const patents = sortCVEntriesByDate((rc?.sections?.patents ?? []) as RenderCVEntry[]);
const conferences = sortCVEntriesByDate((rc?.sections?.conferences ?? []) as RenderCVEntry[]);
const honors = sortCVEntriesByDate((rc?.sections?.honors ?? []) as RenderCVEntry[]);
const awards = sortCVEntriesByDate((rc?.sections?.awards ?? []) as RenderCVEntry[]);
const competitions = sortCVEntriesByDate((rc?.sections?.competitions ?? []) as RenderCVEntry[]);
const academicService = (rc?.sections?.academic_service ?? []) as RenderCVEntry[];
const skills = (rc?.sections?.skills ?? []) as RenderCVEntry[];

const educationLogos = new Map(
  education.flatMap((entry) =>
    entry.institution && entry.logo ? [[entry.institution, entry.logo] as const] : [],
  ),
);

function groupByInstitution(entries: RenderCVEntry[]) {
  const grouped = new Map<string, RenderCVEntry[]>();
  for (const entry of entries) {
    const institution = entry.institution ?? '';
    const group = grouped.get(institution) ?? [];
    group.push(entry);
    grouped.set(institution, group);
  }
  return [...grouped.entries()].map(([institution, groupEntries]) => ({
    institution,
    logo: educationLogos.get(institution),
    entries: groupEntries,
  }));
}

const honorGroups = groupByInstitution(honors);
const awardGroups = groupByInstitution(awards);

const jr = jsonResume ?? null;
const jrLabel = jr?.basics?.label ?? '';

// Build sidebar TOC items based on which sections have data
type TocItem = { label: string; href: string };

const tocItems: TocItem[] = [];
if (format === 'rendercv' && rc) {
  if (rc.name || rc.email || rc.phone || rc.location || rc.date_of_birth || rc.hometown)
    tocItems.push({ label: 'Contact Information', href: '#contact' });
  if (rc.summary) tocItems.push({ label: 'Professional Summary', href: '#summary' });
  if (education.length > 0) tocItems.push({ label: 'Education', href: '#education' });
  if (experience.length > 0) tocItems.push({ label: 'Experience', href: '#experience' });
  if (rcPublications.length > 0) tocItems.push({ label: 'Publications', href: '#publications' });
  if (patents.length > 0) tocItems.push({ label: 'Patents', href: '#patents' });
  if (conferences.length > 0) tocItems.push({ label: 'Conferences', href: '#conferences' });
  if (honors.length > 0) tocItems.push({ label: 'Honors', href: '#honors' });
  if (awards.length > 0) tocItems.push({ label: 'Awards', href: '#awards' });
  if (competitions.length > 0) tocItems.push({ label: 'Competitions', href: '#competitions' });
  if (academicService.length > 0)
    tocItems.push({ label: 'Academic Service', href: '#academic-service' });
  if (skills.length > 0) tocItems.push({ label: 'Skills', href: '#skills' });
} else if (format === 'jsonresume' && jr) {
  if (jr.basics) tocItems.push({ label: 'Contact Information', href: '#contact' });
  if (jr.work?.length) tocItems.push({ label: 'Experience', href: '#experience' });
  if (jr.education?.length) tocItems.push({ label: 'Education', href: '#education' });
  if (jr.publications?.length) tocItems.push({ label: 'Publications', href: '#publications' });
  if (jr.awards?.length) tocItems.push({ label: 'Awards', href: '#awards' });
  if (jr.skills?.length) tocItems.push({ label: 'Skills', href: '#skills' });
  if (jr.languages?.length) tocItems.push({ label: 'Languages', href: '#languages' });
  if (jr.interests?.length) tocItems.push({ label: 'Interests', href: '#interests' });
}
---

<Page title="CV" description={`Curriculum vitae of ${site.author.name}`}>
  <div class="post">
    <header class="post-header">
      <h1 class="post-title heading-with-icon">
        <span class="heading-emoji" aria-hidden="true">📄</span>
        <span>CV</span>
        {
          site.cv.pdfPath && (
            <a
              href={withBase(site.cv.pdfPath)}
              target="_blank"
              rel="noopener noreferrer"
              class="float-right"
              aria-label="Download CV PDF"
            >
              <IconFilePdf />
            </a>
          )
        }
      </h1>
    </header>

    <article>
      <div class="cv-page-wrapper">
        <!-- Sidebar TOC -->
        {
          tocItems.length > 0 && (
            <nav class="cv-sidebar-toc" aria-label="CV sections">
              <ul>
                {tocItems.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <!-- CV content -->
        <div class="cv">
          <!-- ── RENDERCV ──────────────────────────────────────────────── -->
          {
            format === 'rendercv' && renderCV && (
              <>
                {rc &&
                  (rc.name ||
                    rc.email ||
                    rc.phone ||
                    rc.date_of_birth ||
                    rc.hometown ||
                    rc.location) && (
                    <CVSection title="Contact Information" id="contact" icon="👤">
                      <div class="cv-contact-layout">
                        <table class="table-cv table-sm table-borderless table">
                          {rc.name && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>Name</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{rc.name}</td>
                            </tr>
                          )}
                          {rc.email && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>Email</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{rc.email}</td>
                            </tr>
                          )}
                          {rc.phone && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>Phone</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{rc.phone}</td>
                            </tr>
                          )}
                          {rc.location && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>Location</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{rc.location}</td>
                            </tr>
                          )}
                          {rc.date_of_birth && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>Date of Birth</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{rc.date_of_birth}</td>
                            </tr>
                          )}
                          {rc.hometown && (
                            <tr>
                              <td class="font-weight-bold p-1 pr-2">
                                <b>Hometown</b>
                              </td>
                              <td class="font-weight-light p-1 pl-2">{rc.hometown}</td>
                            </tr>
                          )}
                        </table>
                        {site.cv.photoPath && (
                          <img
                            class="cv-portrait"
                            src={withBase(site.cv.photoPath)}
                            alt={`${site.author.name} formal portrait`}
                            width="128"
                            height="160"
                            style={`object-position: ${site.cv.photoPosition};`}
                          />
                        )}
                      </div>
                    </CVSection>
                  )}

                {rc?.summary && (
                  <CVSection title="Professional Summary" id="summary" icon="👀">
                    <p class="card-text font-weight-light">{rc.summary}</p>
                  </CVSection>
                )}

                {education.length > 0 && (
                  <CVSection title="Education" id="education" icon="🎓">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {education.map((e) => (
                        <CVEntry
                          title={[e.degree, e.area].filter(Boolean).join(' in ')}
                          subtitle={e.institution}
                          location={e.location}
                          dates={formatDateRange(e.start_date, e.end_date)}
                          highlights={e.highlights}
                          logo={e.logo}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {experience.length > 0 && (
                  <CVSection title="Experience" id="experience" icon="💼">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {experience.map((e) => (
                        <CVEntry
                          title={e.position ?? ''}
                          subtitle={e.company}
                          location={e.location}
                          dates={formatDateRange(e.start_date, e.end_date)}
                          highlights={e.highlights}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {rcPublications.length > 0 && (
                  <CVSection title="Selected Publications" id="publications" icon="📰">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {rcPublications.map((e) => (
                        <CVPublicationEntry
                          title={e.title ?? ''}
                          authors={e.authors}
                          venue={e.journal}
                          dates={formatCVDate(e.date)}
                          url={e.doi ? `https://doi.org/${e.doi}` : e.url}
                          authorLastName={site.publications.authorLastName}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {patents.length > 0 && (
                  <CVSection title="Patents" id="patents" icon="📜">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {patents.map((e) => (
                        <CVEntry
                          title={e.title ?? ''}
                          subtitle={e.issuer}
                          subtitleMuted={true}
                          dates={formatCVDate(e.date)}
                          highlights={e.highlights}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {conferences.length > 0 && (
                  <CVSection title="Conferences" id="conferences" icon="🎤">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {conferences.map((e) => (
                        <CVEntry
                          title={e.title ?? ''}
                          subtitle={e.issuer}
                          location={e.location}
                          dates={formatCVDate(e.date)}
                          url={e.url}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {honors.length > 0 && (
                  <CVSection title="Honors" id="honors" icon="🏅">
                    {honorGroups.map((group) => (
                      <CVInstitutionGroup institution={group.institution} logo={group.logo}>
                        {group.entries.map((e) => (
                          <CVEntry
                            title={e.name ?? ''}
                            subtitle={e.issuer}
                            dates={formatCVDate(e.date)}
                            highlights={e.highlights}
                            url={e.url}
                          />
                        ))}
                      </CVInstitutionGroup>
                    ))}
                  </CVSection>
                )}

                {awards.length > 0 && (
                  <CVSection title="Awards" id="awards" icon="🥇">
                    {awardGroups.map((group) => (
                      <CVInstitutionGroup institution={group.institution} logo={group.logo}>
                        {group.entries.map((e) => (
                          <CVEntry
                            title={e.name ?? ''}
                            subtitle={e.issuer}
                            inlineMeta={e.highlights?.[0]}
                            dates={formatCVDate(e.date)}
                            url={e.url}
                          />
                        ))}
                      </CVInstitutionGroup>
                    ))}
                  </CVSection>
                )}

                {competitions.length > 0 && (
                  <CVSection title="Competitions" id="competitions" icon="🏆">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {competitions.map((e) => (
                        <CVEntry
                          title={e.name ?? ''}
                          subtitle={e.issuer}
                          dates={formatCVDate(e.date)}
                          url={e.url}
                          badges={[
                            ...(e.level
                              ? [
                                  {
                                    label: e.level,
                                    tone:
                                      e.level === 'National'
                                        ? ('national' as const)
                                        : ('provincial' as const),
                                  },
                                ]
                              : []),
                            ...(e.prize ? [{ label: e.prize, tone: 'award' as const }] : []),
                          ]}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {academicService.length > 0 && (
                  <CVSection title="Academic Service" id="academic-service" icon="🔍">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {academicService.map((e) => (
                        <CVEntry title={e.name ?? ''} highlights={e.highlights} />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {skills.length > 0 && (
                  <CVSection title="Skills" id="skills" icon="🛠️">
                    <div class="card-text font-weight-light">
                      {skills.map((e) => (
                        <div class="skill-item">
                          <strong>{e.label}:</strong> {e.details}
                        </div>
                      ))}
                    </div>
                  </CVSection>
                )}
              </>
            )
          }

          <!-- ── JSONRESUME ─────────────────────────────────────────────── -->
          {
            format === 'jsonresume' && jsonResume && (
              <>
                {jr?.basics && (
                  <CVSection title="Contact Information" id="contact" icon="👤">
                    <table class="table-cv table-sm table-borderless table">
                      {jr.basics.name && (
                        <tr>
                          <td class="font-weight-bold p-1 pr-2">
                            <b>Name</b>
                          </td>
                          <td class="font-weight-light p-1 pl-2">{jr.basics.name}</td>
                        </tr>
                      )}
                      {jrLabel && (
                        <tr>
                          <td class="font-weight-bold p-1 pr-2">
                            <b>Professional Title</b>
                          </td>
                          <td class="font-weight-light p-1 pl-2">{jrLabel}</td>
                        </tr>
                      )}
                      {jr.basics.email && (
                        <tr>
                          <td class="font-weight-bold p-1 pr-2">
                            <b>Email</b>
                          </td>
                          <td class="font-weight-light p-1 pl-2">{jr.basics.email}</td>
                        </tr>
                      )}
                      {jr.basics.phone && (
                        <tr>
                          <td class="font-weight-bold p-1 pr-2">
                            <b>Phone</b>
                          </td>
                          <td class="font-weight-light p-1 pl-2">{jr.basics.phone}</td>
                        </tr>
                      )}
                      {jr.basics.url && (
                        <tr>
                          <td class="font-weight-bold p-1 pr-2">
                            <b>Website</b>
                          </td>
                          <td class="font-weight-light p-1 pl-2">
                            <a href={jr.basics.url} target="_blank" rel="noopener noreferrer">
                              {jr.basics.url}
                            </a>
                          </td>
                        </tr>
                      )}
                    </table>
                  </CVSection>
                )}

                {jr?.work && jr.work.length > 0 && (
                  <CVSection title="Experience" id="experience" icon="💼">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {jr.work.map((e) => (
                        <CVEntry
                          title={e.position ?? ''}
                          subtitle={e.name}
                          url={e.url}
                          dates={formatDateRange(e.startDate, e.endDate)}
                          highlights={e.highlights}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {jr?.education && jr.education.length > 0 && (
                  <CVSection title="Education" id="education" icon="🎓">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {jr.education.map((e) => (
                        <CVEntry
                          title={[e.studyType, e.area].filter(Boolean).join(' in ')}
                          subtitle={e.institution}
                          url={e.url}
                          dates={formatDateRange(e.startDate, e.endDate)}
                          highlights={e.courses}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {jr?.publications && jr.publications.length > 0 && (
                  <CVSection title="Selected Publications" id="publications" icon="📰">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {jr.publications.map((e) => (
                        <CVEntry
                          title={e.name ?? ''}
                          subtitle={e.publisher}
                          url={e.url}
                          dates={formatCVDate(e.releaseDate)}
                          highlights={e.summary ? [e.summary] : []}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {jr?.awards && jr.awards.length > 0 && (
                  <CVSection title={'Honors & Awards'} id="awards" icon="🏅">
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      {jr.awards.map((e) => (
                        <CVEntry
                          title={e.title ?? ''}
                          subtitle={e.awarder}
                          dates={formatCVDate(e.date)}
                          highlights={e.summary ? [e.summary] : []}
                        />
                      ))}
                    </ul>
                  </CVSection>
                )}

                {jr?.skills && jr.skills.length > 0 && (
                  <CVSection title="Skills" id="skills" icon="🛠️">
                    <div class="card-text font-weight-light">
                      {jr.skills.map((e) => (
                        <div class="skill-item">
                          <strong>{e.name}:</strong> {e.keywords?.join(', ')}
                        </div>
                      ))}
                    </div>
                  </CVSection>
                )}

                {jr?.languages && jr.languages.length > 0 && (
                  <CVSection title="Languages" id="languages" icon="🌐">
                    <div class="card-text font-weight-light">
                      {jr.languages.map((e) => (
                        <div class="skill-item">
                          <strong>{e.language}:</strong> {e.fluency}
                        </div>
                      ))}
                    </div>
                  </CVSection>
                )}

                {jr?.interests && jr.interests.length > 0 && (
                  <CVSection title="Interests" id="interests" icon="❤️">
                    <div class="card-text font-weight-light">
                      {jr.interests.map((e) => (
                        <div class="skill-item">
                          <strong>{e.name}:</strong> {e.keywords?.join(', ')}
                        </div>
                      ))}
                    </div>
                  </CVSection>
                )}
              </>
            )
          }
        </div><!-- /.cv -->
      </div><!-- /.cv-page-wrapper -->
    </article>
  </div>
</Page>

<style>
  /* Two-column layout: sidebar + content */
  .cv-page-wrapper {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .post-title > a {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
  }

  /* Sticky left sidebar TOC */
  .cv-sidebar-toc {
    flex-shrink: 0;
    width: 165px;
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }

  .cv-sidebar-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--global-divider-color);
  }

  .cv-sidebar-toc li a {
    display: block;
    padding: 0.24rem 0 0.24rem 0.7rem;
    font-size: 0.8rem;
    color: var(--global-text-color-light);
    text-decoration: none;
    transition: color 0.15s ease;
    line-height: 1.3;
  }

  .cv-sidebar-toc li a:hover {
    color: var(--global-theme-color);
  }

  /* Main CV content fills remaining space */
  .cv {
    flex: 1;
    min-width: 0;
  }

  .cv-contact-layout {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .cv-contact-layout .table-cv {
    flex: 1;
    min-width: 0;
  }

  .cv-portrait {
    width: 128px;
    aspect-ratio: 4 / 5;
    height: auto;
    flex: 0 0 128px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--global-divider-color);
  }

  /* Hide sidebar on small screens */
  @media (max-width: 768px) {
    .cv-page-wrapper {
      flex-direction: column;
    }
    .cv-sidebar-toc {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .cv-contact-layout {
      flex-direction: column-reverse;
    }

    .cv-portrait {
      align-self: center;
    }
  }
</style>
