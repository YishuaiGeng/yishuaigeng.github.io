---
import { site } from '@config/site';

const { visitors } = site;
const visible = visitors.enabled && visitors.scriptUrl && visitors.statisticsUrl;
---

{
  visible && (
    <section class="visitor-section" aria-labelledby="visitor-heading" data-pagefind-ignore>
      <h2 id="visitor-heading">{visitors.labels.title}</h2>
      <div class="visitor-map" style={`max-width: ${visitors.maxWidth}px;`}>
        <script
          is:inline
          data-astro-rerun
          type="text/javascript"
          id="mapmyvisitors"
          src={visitors.scriptUrl}
          async
        />
        <noscript>
          <a href={visitors.statisticsUrl} title={visitors.labels.details}>
            <img src={visitors.imageUrl} alt={visitors.labels.mapAlt} />
          </a>
        </noscript>
      </div>
      <p class="visitor-caption">
        <a href={visitors.statisticsUrl} target="_blank" rel="noopener noreferrer">
          {visitors.labels.caption}
        </a>
      </p>
    </section>
  )
}

<style>
  .visitor-section {
    clear: both;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--global-divider-color);
    text-align: center;
  }

  h2 {
    margin: 0 0 1rem;
    color: var(--global-text-color);
    font-size: 1rem;
    font-weight: 600;
  }

  .visitor-map {
    display: block;
    width: 100%;
    min-height: 180px;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
  }

  a:focus-visible,
  .visitor-map :global(a:focus-visible) {
    outline: 2px solid var(--global-theme-color);
    outline-offset: 4px;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .visitor-map :global(#mapmyvisitors-widget) {
    max-width: 100%;
  }

  .visitor-caption {
    margin: 0.75rem 0 0;
    color: var(--global-text-color-light);
    font-size: 0.75rem;
  }

  .visitor-caption a {
    color: inherit;
    text-decoration: none;
  }

  .visitor-caption a:hover {
    color: var(--global-theme-color);
    text-decoration: underline;
  }
</style>
