---
import { site } from '@config/site';

const { visitors } = site;
const visible = visitors.enabled && visitors.imageUrl && visitors.statisticsUrl;
---

{
  visible && (
    <section class="visitor-section" aria-labelledby="visitor-heading" data-pagefind-ignore>
      <h2 id="visitor-heading">{visitors.labels.title}</h2>
      <a
        class="visitor-map"
        href={visitors.statisticsUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={visitors.labels.details}
      >
        <img
          src={visitors.imageUrl}
          alt={visitors.labels.mapAlt}
          width={visitors.width}
          height={visitors.height}
          loading="eager"
          decoding="async"
          referrerpolicy="strict-origin-when-cross-origin"
        />
      </a>
      <p class="visitor-caption">{visitors.labels.caption}</p>
    </section>
  )
}

<style>
  .visitor-section {
    clear: both;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--global-divider-color);
    text-align: center;
  }

  h2 {
    margin: 0 0 1rem;
    color: var(--global-text-color);
    font-size: 1rem;
    font-weight: 600;
  }

  .visitor-map {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    background: var(--color-white);
  }

  .visitor-map:focus-visible {
    outline: 2px solid var(--global-theme-color);
    outline-offset: 4px;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .visitor-caption {
    margin: 0.75rem 0 0;
    color: var(--global-text-color-light);
    font-size: 0.75rem;
  }
</style>
