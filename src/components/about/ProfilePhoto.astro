---
import { site } from '@config/site';
import { withBase } from '@utils/base';

interface Props {
  src?: string;
  alt?: string;
  align?: 'left' | 'right';
  circular?: boolean;
}

const {
  src = site.author.avatar,
  alt = site.author.name,
  align = 'right',
  circular = false,
} = Astro.props;

const imgSrc = withBase(src);
const fallback = withBase('/assets/img/prof_pic.png');
const imgClass = circular ? 'img-fluid z-depth-1 rounded-circle' : 'img-fluid z-depth-1 rounded';
const objectPosition = src === site.author.avatar ? site.author.avatarPosition : '50% 50%';
---

<div class={`profile float-${align}`}>
  <div class="photo-frame">
    <img
      src={imgSrc}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      width="240"
      height="300"
      class={imgClass}
      style={`object-position: ${objectPosition};`}
      onerror={`this.src='${fallback}'`}
    />
  </div>
  {site.author.moreInfo && <div class="more-info" set:html={site.author.moreInfo} />}
  {
    Astro.slots.has('default') && (
      <div class="profile-extra">
        <slot />
      </div>
    )
  }
</div>

<style>
  .photo-frame,
  .profile-extra {
    width: 100%;
    max-width: 240px;
    margin-inline: auto;
  }

  .photo-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
  }

  .photo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-extra {
    display: flex;
    justify-content: center;
    margin-top: 0.65rem;
  }

  .profile-extra :global(.profile-social) {
    width: 100%;
    justify-content: center;
    gap: 0.65rem;
  }
</style>
