---
import PostCard from '@components/blog/PostCard.astro';
import { site } from '@config/site';
import { withBase } from '@utils/base';
import { readingTime } from '@utils/reading-time';
import type { ComponentProps } from 'astro/types';

import IconClock from '~icons/fa-regular/clock';
import IconArrowUpRight from '~icons/fa-solid/external-link-alt';

interface Props {
  posts: ComponentProps<typeof PostCard>['post'][];
}

const { posts } = Astro.props;
const { labels, timeline } = site.blog;
const postsByYear = new Map<number, typeof posts>();
for (const post of [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime())) {
  const year = post.data.date.getUTCFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}
const years = [...postsByYear.keys()];
const dayFormat = new Intl.DateTimeFormat(site.lang, { day: '2-digit', timeZone: 'UTC' });
const monthFormat = new Intl.DateTimeFormat(site.lang, { month: 'short', timeZone: 'UTC' });
const dateFormat = new Intl.DateTimeFormat(site.lang, { dateStyle: 'long', timeZone: 'UTC' });
---

{
  timeline.enabled ? (
    <div class="blog-timeline">
      {years.length > 1 && (
        <nav class="year-navigation" aria-label={labels.browseByYear}>
          <span>{labels.browseByYear}</span>
          {years.map((year) => (
            <a href={`#notes-${year}`}>{year}</a>
          ))}
        </nav>
      )}
      {years.map((year) => {
        const entries = postsByYear.get(year)!;
        return (
          <section class="timeline-year" aria-labelledby={`notes-${year}`}>
            <header class="year-heading">
              <h2 id={`notes-${year}`}>
                {entries.some((post) => !('external' in post)) ? (
                  <a href={`${site.base}/blog/year/${year}/`}>
                    <time datetime={String(year)}>{year}</time>
                  </a>
                ) : (
                  <time datetime={String(year)}>{year}</time>
                )}
              </h2>
              <span class="year-count">
                {entries.length} {entries.length === 1 ? labels.noteSingular : labels.notePlural}
              </span>
            </header>
            <ol class="timeline-entries">
              {entries.map((post) => {
                const external = 'external' in post;
                const redirect = 'redirect' in post.data ? post.data.redirect : undefined;
                const href = external ? post.url : redirect || `${site.base}/blog/${post.id}/`;
                const opensNewTab = external || Boolean(redirect);
                const minutes = post.body
                  ? readingTime(post.body, site.blog.wordsPerMinute)
                  : undefined;
                return (
                  <li class="timeline-entry">
                    <time
                      class="entry-date"
                      datetime={post.data.date.toISOString()}
                      aria-label={dateFormat.format(post.data.date)}
                    >
                      <span class="entry-day" aria-hidden="true">
                        {dayFormat.format(post.data.date)}
                      </span>
                      <span class="entry-month" aria-hidden="true">
                        {monthFormat.format(post.data.date)}
                      </span>
                    </time>
                    <article class="entry-content">
                      <div class="entry-copy">
                        <h3>
                          <a
                            class="entry-title"
                            href={href}
                            {...(opensNewTab
                              ? { target: '_blank', rel: 'noopener noreferrer' }
                              : {})}
                          >
                            {post.data.title}
                            {opensNewTab && <IconArrowUpRight aria-label={labels.externalLink} />}
                          </a>
                        </h3>
                        {timeline.showDescriptions && post.data.description && (
                          <p class="entry-description">{post.data.description}</p>
                        )}
                        <div class="entry-meta">
                          {post.data.categories.map((category) => (
                            <a
                              class="entry-category"
                              href={`${site.base}/blog/category/${encodeURIComponent(category)}/`}
                            >
                              {category}
                            </a>
                          ))}
                          {minutes && (
                            <span class="entry-reading-time">
                              <IconClock aria-hidden="true" />
                              {minutes} {labels.readingTime}
                            </span>
                          )}
                        </div>
                      </div>
                      {post.data.image && (
                        <img
                          class="entry-image"
                          src={withBase(post.data.image)}
                          alt=""
                          width="76"
                          height="64"
                          loading="lazy"
                        />
                      )}
                    </article>
                  </li>
                );
              })}
            </ol>
          </section>
        );
      })}
    </div>
  ) : (
    years.map((year) => (
      <section aria-labelledby={`notes-${year}`}>
        <h2 class="year" id={`notes-${year}`}>
          {year}
        </h2>
        <ul class="post-list">
          {postsByYear.get(year)!.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </section>
    ))
  )
}

<style>
  .blog-timeline {
    --timeline-axis: 4rem;
    --timeline-indent: 5.75rem;
    --timeline-line: color-mix(in srgb, var(--global-theme-color) 20%, var(--global-divider-color));
    --timeline-tint: color-mix(in srgb, var(--global-theme-color) 6%, var(--global-bg-color));
    margin-top: 0.75rem;
  }

  .year-navigation {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--global-text-color-light);
  }

  .year-navigation a {
    border: 1px solid var(--global-divider-color);
    border-radius: 2rem;
    padding: 0.35rem 0.8rem;
  }

  .timeline-year {
    position: relative;
  }

  .timeline-year::before {
    background: var(--timeline-line);
    bottom: 0;
    content: '';
    left: var(--timeline-axis);
    position: absolute;
    top: 0;
    width: 1px;
  }

  .timeline-year:first-of-type::before {
    top: 2.1rem;
  }

  .timeline-year:last-child::before {
    background: linear-gradient(var(--timeline-line) 92%, transparent);
  }

  .year-heading {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    min-height: 4.25rem;
    padding-left: var(--timeline-indent);
    position: relative;
  }

  .year-heading::before {
    background: var(--global-bg-color);
    border: 3px solid var(--global-theme-color);
    border-radius: 50%;
    content: '';
    height: 13px;
    left: calc(var(--timeline-axis) - 6px);
    position: absolute;
    width: 13px;
  }

  .year-heading h2 {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin: 0;
    scroll-margin-top: calc(var(--navbar-height) + 1.5rem);
  }

  .year-heading a {
    color: inherit;
  }

  .year-heading a:hover {
    color: var(--global-theme-color);
  }

  .year-count {
    color: var(--global-text-color-light);
    font-size: 0.75rem;
  }

  .timeline-entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-entry {
    padding-left: var(--timeline-indent);
    position: relative;
  }

  .timeline-entry::before {
    background: var(--global-bg-color);
    border: 2px solid var(--timeline-line);
    border-radius: 50%;
    content: '';
    height: 9px;
    left: calc(var(--timeline-axis) - 4px);
    position: absolute;
    top: 1.55rem;
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
    width: 9px;
  }

  .timeline-entry:hover::before,
  .timeline-entry:focus-within::before {
    background: var(--global-theme-color);
    border-color: var(--global-theme-color);
  }

  .entry-date {
    align-items: center;
    color: var(--global-text-color-light);
    display: flex;
    flex-direction: column;
    font-variant-numeric: tabular-nums;
    left: 0;
    line-height: 1.25;
    position: absolute;
    top: 1.15rem;
    width: 2.75rem;
  }

  .entry-day {
    color: var(--global-text-color);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .entry-month {
    font-size: 0.7rem;
    margin-top: 0.15rem;
  }

  .entry-content {
    align-items: flex-start;
    border-bottom: 1px solid var(--global-divider-color);
    display: flex;
    gap: 1rem;
    padding: 1rem 0 1.25rem;
  }

  .timeline-entry:last-child .entry-content {
    border-bottom-color: transparent;
  }

  .entry-copy {
    flex: 1;
    min-width: 0;
  }

  .entry-copy h3 {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.65;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .entry-title {
    color: var(--global-text-color);
    text-decoration: none;
  }

  .entry-title:hover {
    color: var(--global-theme-color);
  }

  .entry-title :global(svg) {
    display: inline;
    height: 0.7em;
    margin-left: 0.45em;
    width: 0.7em;
  }

  .entry-description {
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--global-text-color-light);
    display: -webkit-box;
    font-size: 0.84rem;
    line-height: 1.75;
    margin: 0.35rem 0 0;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .entry-meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 0.6rem;
  }

  .entry-category {
    background: var(--timeline-tint);
    border-radius: 4px;
    color: var(--global-theme-color);
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    overflow-wrap: anywhere;
  }

  .entry-category:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .entry-reading-time {
    align-items: center;
    color: var(--global-text-color-light);
    display: inline-flex;
    font-size: 0.7rem;
    gap: 0.3rem;
  }

  .entry-reading-time :global(svg) {
    height: 0.75rem;
    width: 0.75rem;
  }

  .entry-image {
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    flex: 0 0 auto;
    height: 64px;
    margin-top: 0.25rem;
    object-fit: cover;
    width: 76px;
  }

  a:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--global-theme-color);
    outline-offset: 4px;
  }

  @media (max-width: 540px) {
    .blog-timeline {
      --timeline-axis: 2.9rem;
      --timeline-indent: 4rem;
    }

    .entry-date {
      width: 2rem;
    }

    .entry-copy h3 {
      font-size: 1rem;
    }

    .entry-image {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-entry::before {
      transition: none;
    }
  }
</style>
