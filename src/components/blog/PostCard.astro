---
import { site } from '@config/site';
import { withBase } from '@utils/base';
import { readingTime } from '@utils/reading-time';
import type { CollectionEntry } from 'astro:content';

import IconClock from '~icons/fa-solid/clock';
import IconHashtag from '~icons/fa-solid/hashtag';
import IconTag from '~icons/fa-solid/tag';

/** A local post from the 'blogs' collection. */
type LocalPost = CollectionEntry<'blogs'>;

/** A synthetic external post object (constructed in blog listing pages). */
interface ExternalPost {
  external: true;
  id: string;
  url: string;
  data: {
    title: string;
    date: Date;
    description?: string;
    tags: string[];
    categories: string[];
    image?: string;
  };
  body?: undefined;
}

type PostEntry = LocalPost | ExternalPost;

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;

const isExternal = 'external' in post && post.external === true;

const title = post.data.title;
const date = post.data.date;
const description = post.data.description;
const tags = post.data.tags ?? [];
const categories = post.data.categories ?? [];
// Use `image` field as thumbnail (matches schema field name)
const thumbnail = (post.data as { image?: string }).image;
const thumbnailSrc = thumbnail ? withBase(thumbnail) : undefined;

const href = isExternal ? (post as ExternalPost).url : `${site.base}/blog/${post.id}/`;

const minutes =
  !isExternal && (post as LocalPost).body ? readingTime((post as LocalPost).body!) : undefined;

const d = date instanceof Date ? date : new Date(date);
const formattedDate = d.toLocaleDateString(site.lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const taxonomy = [
  ...tags.map((value) => ({ value, kind: 'tag' as const })),
  ...categories.map((value) => ({ value, kind: 'category' as const })),
];
---

{
  thumbnail ? (
    <div class="row">
      <div class="col-sm-9">
        <div class="post-title-row">
          <h3>
            <a
              class="post-title"
              href={href}
              {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {title}
              {isExternal && (
                <span style="font-size: 0.7em; opacity: 0.6; margin-left: 0.25em;">&#x2197;</span>
              )}
            </a>
          </h3>
          <div class="post-title-meta">
            <time datetime={d.toISOString()}>{formattedDate}</time>
            {minutes && (
              <span class="reading-time">
                <IconClock aria-hidden="true" />
                <span>
                  {minutes} {site.blog.labels.readingTime}
                </span>
              </span>
            )}
          </div>
        </div>
        {description && <p>{description}</p>}
        <p class="post-tags">
          {taxonomy.map((item, index) => (
            <>
              {index > 0 && <>&nbsp;&middot;&nbsp;</>}
              <a href={`${site.base}/blog/${item.kind}/${item.value}/`}>
                {item.kind === 'tag' ? <IconHashtag /> : <IconTag />}
                &nbsp;{item.value}
              </a>
            </>
          ))}
        </p>
      </div>
      <div class="col-sm-3">
        <img
          class="img-fluid z-depth-1 rounded"
          src={thumbnailSrc}
          alt=""
          loading="lazy"
          width="150"
          height="120"
        />
      </div>
    </div>
  ) : (
    <>
      <div class="post-title-row">
        <h3>
          <a
            class="post-title"
            href={href}
            {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {title}
            {isExternal && (
              <span style="font-size: 0.7em; opacity: 0.6; margin-left: 0.25em;">&#x2197;</span>
            )}
          </a>
        </h3>
        <div class="post-title-meta">
          <time datetime={d.toISOString()}>{formattedDate}</time>
          {minutes && (
            <span class="reading-time">
              <IconClock aria-hidden="true" />
              <span>
                {minutes} {site.blog.labels.readingTime}
              </span>
            </span>
          )}
        </div>
      </div>
      {description && <p>{description}</p>}
      <p class="post-tags">
        {taxonomy.map((item, index) => (
          <>
            {index > 0 && <>&nbsp;&middot;&nbsp;</>}
            <a href={`${site.base}/blog/${item.kind}/${item.value}/`}>
              {item.kind === 'tag' ? <IconHashtag /> : <IconTag />}
              &nbsp;{item.value}
            </a>
          </>
        ))}
      </p>
    </>
  )
}

<style>
  .post-title-row {
    align-items: baseline;
    column-gap: 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    row-gap: 0.25rem;
  }

  .post-title-row h3 {
    flex: 1 1 22rem;
    margin-bottom: 0;
    min-width: 0;
  }

  .post-title-meta {
    align-items: center;
    color: var(--global-text-color-light);
    display: inline-flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    font-size: 0.78rem;
    gap: 0.75rem;
  }

  .reading-time {
    align-items: center;
    display: inline-flex;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .reading-time :global(svg) {
    height: 0.75rem;
    width: 0.75rem;
  }

  .post-tags {
    margin-bottom: 0;
  }
</style>
